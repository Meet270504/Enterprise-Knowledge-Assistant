# --- Application ---
APP_NAME=Enterprise Generative AI Knowledge Assistant
# Hosting platforms (Railway, Render, Fly.io, etc.) inject PORT automatically.
PORT=8000
HOST=0.0.0.0

# --- Database (PostgreSQL + pgvector) ---
# docker-compose default:
DATABASE_URL=postgresql+asyncpg://eka:eka_secret@localhost:5432/eka
# Sync URL used for startup/migrations helpers if needed:
DATABASE_URL_SYNC=postgresql://eka:eka_secret@localhost:5432/eka

# --- OpenAI (leave empty to run local demo mode) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Alternative: gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Mode flags ---
# When true (or when OPENAI_API_KEY is empty), the app uses fictional docs +
# deterministic local retrieval. Answers show evidence excerpts, not GPT text.
# For a public recruiter demo with real OpenAI answers: DEMO_MODE=false + key set.
DEMO_MODE=true
# Seed fictional sample policies into an empty database on startup.
SEED_DEMO_DOCUMENTS=true
# Public demo: disable anonymous uploads and document deletion.
PUBLIC_DEMO=false

# --- Local LLM for demo mode (Ollama) ---
# Used when DEMO_MODE=true / no OpenAI key, for grounded answers without OpenAI.
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=phi3:mini

# --- Public demo spend guards (/api/query) ---
# Per-IP questions per rolling hour. 0 = disabled.
QUERY_RATE_LIMIT_PER_IP=8
# Total questions per UTC calendar day (all visitors). 0 = disabled.
# Raise temporarily on interview day if needed.
QUERY_DAILY_GLOBAL_LIMIT=40

# --- Ingestion / retrieval ---
MAX_UPLOAD_BYTES=10485760
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# Use TOP_K=3 on public OpenAI demos to shrink prompt size slightly.
TOP_K=5
# Cosine similarity threshold (1 - cosine_distance). Chunks below this are ignored.
RELEVANCE_THRESHOLD=0.12
UPLOAD_DIR=uploads

# --- Embedding isolation ---
# Demo mode uses embedding_provider=local and embedding_model=demo-hash-v1.
# OpenAI mode uses embedding_provider=openai and the configured embedding model.
# Retrieval never mixes vectors across providers/models.
